# Local mode is unchanged. Public deployment MUST use APP_ENV=production.
APP_ENV=development
DEMO_USERNAME=viewer
# Generate a unique random password (at least 16 characters) before publishing.
# Leave empty only for private local development. Never commit the real .env.
DEMO_PASSWORD=
# Optional: defaults to false in production, true in development.
# ENABLE_API_DOCS=false
# MAX_REQUEST_BYTES=54525952
# UPLOAD_REQUESTS_PER_MINUTE=10
# MAX_CONCURRENT_UPLOADS=2
# MAX_STORAGE_BYTES=536870912

# Model provider (retrieval works without it; grounded answers require it).
# Only use this key in a local ignored .env or the host's secret settings.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# LLM_TIMEOUT_SECONDS=45

# Local application storage
DATABASE_URL=sqlite:///./data/tracescholar.db
STORAGE_DIR=./data

# Optional retrieval settings
EMBEDDING_MODEL=
RERANKER_MODEL=

# CPU OCR: Docker includes English and Simplified Chinese Tesseract language packs.
# English official papers use eng; use eng+chi_sim for mixed-language scans.
# OCR_LANGUAGES=eng
